{
  "name": "wikicollect",
  "version": "0.1.0",
  "private": true,
  "description": "Collect every Wikipedia article as a trading card: open packs, complete albums, trade duplicates, ace quizzes.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js --demo",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
